{
  "manifest_version": 2,
  "name": "Semo Shield",
  "version": "1.6",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@semo.browser"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "cookies",
    "storage",
    "nativeMessaging",
    "geckoViewAddons",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "hub.js",
        "pw.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hub.js",
        "page.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules-ads.json"
      }
    ]
  }
}