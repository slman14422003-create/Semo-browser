{
  "manifest_version": 2,
  "name": "Semo Shield",
  "version": "1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@semo.browser"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "pw.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
